# Document required environment variables here; never include secrets.

# apps/streamlit_ui
DATABASE_URL=sqlite:///itap.db
MIN_DAYS_BEFORE_CLOSURE=30

# Self-managed Postgres (apps/postgres_service/) — for when CML won't
# provision a database service. Leave EMBED_POSTGRES unset/false to
# keep using DATABASE_URL above (SQLite by default). See
# apps/postgres_service/README.md before turning this on.
# EMBED_POSTGRES=true
# PG_DATA_DIR=/path/to/persistent/pgdata
# PG_PORT=5432
# PG_USER=itap
# PG_PASSWORD=
# PG_DB=itap
